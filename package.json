{
  "name": "uwifin",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "format": "pnpm format:web && pnpm format:api",
    "format:check": "pnpm format:web:check && pnpm format:api:check",
    "format:web": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:web:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:api": "cargo fmt --manifest-path services/api/Cargo.toml",
    "format:api:check": "cargo fmt --manifest-path services/api/Cargo.toml -- --check",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "cargo run --manifest-path services/api/Cargo.toml",
    "lint:web": "pnpm --dir apps/web lint",
    "check:api": "cargo check --manifest-path services/api/Cargo.toml",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build:web": "pnpm --dir apps/web build",
    "test:web": "pnpm --dir apps/web test"
  },
  "packageManager": "pnpm@10.34.5",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.5",
      "onFail": "error"
    }
  },
  "pnpm": {
    "overrides": {
      "jayson": "5.0.0",
      "js-cookie": "3.0.7",
      "ws@>=8 <8.21.0": "8.21.0",
      "uuid@>=8 <11.1.1": "11.1.1",
      "decode-uri-component@<0.5.0": "0.5.0",
      "x402@0.7.3>wagmi": "-"
    }
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
