# Server-only Next.js BFF configuration. Never prefix provider secrets NEXT_PUBLIC_.
API_URL=http://127.0.0.1:8080
APP_BASE_URL=http://localhost:3000
# Only development permits loopback HTTP for wallet authentication; use production + HTTPS when deployed.
APP_ENV=development

# Public Privy app ID; enable Custom Authentication (client-side JWT) and both embedded wallet types.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only P-256 PKCS8 PEM; use escaped \n on one line. See docs/wallet-operations.md.
PRIVY_JWT_PRIVATE_KEY=
PRIVY_JWT_KEY_ID=uwifin-1
