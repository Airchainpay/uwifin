APP_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=mysql://uwifin:uwifin@localhost:3306/uwifin

# Default network: base, eth-mainnet, or solana-mainnet. These use real funds.
# Explicit base-sepolia remains available for EVM testing.
ALCHEMY_NETWORK=base
ALCHEMY_API_KEY=
# Default-network policy (legacy setting); network-specific policies take precedence.
ALCHEMY_POLICY_ID=
# One Alchemy key may serve all networks if enabled in its provider dashboard.
# Per-network keys/endpoints and Gas Manager policies:
BASE_ALCHEMY_API_KEY=
BASE_POLICY_ID=
ETHEREUM_ALCHEMY_API_KEY=
ETHEREUM_POLICY_ID=
SOLANA_POLICY_ID=
SOLANA_ALCHEMY_API_KEY=
# SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/...
# BASE_RPC_URL=
# ETHEREUM_RPC_URL=
# BASE_WALLET_URL=
# ETHEREUM_WALLET_URL=
# Optional explicit provider endpoints (HTTPS in production):
# ALCHEMY_RPC_URL=
# ALCHEMY_WALLET_URL=
BLOCK_CONFIRMATIONS=3
MAX_TRANSFER_ATOMIC=1000000000

# Stripe Crypto Onramp requires approval, including test mode.
# On-ramp supports USDC on Base, Ethereum and Solana mainnet with all three keys configured.
STRIPE_ONRAMP_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
